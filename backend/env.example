# RupAI Backend — Environment Variables Template
# ─────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file:  copy env.example .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env — it is gitignored
# ─────────────────────────────────────────────────

# ─── Supabase ───────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Service Role Key — has full DB access, used server-side ONLY
# From: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# JWT Secret — used to verify user tokens
# From: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ─── Groq API (Primary Ultra-Fast LLM) ──────────────────
# From: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Google AI (Gemini Fallback) ────────────────────────
# From: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Google Places API (Optional) ───────────────────────
# From: Google Cloud Console → APIs & Services → Credentials
# Enable: Places API (New)
PLACES_API_KEY=your-google-places-api-key-here
