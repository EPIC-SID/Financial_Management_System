# RupAI Backend — Environment Variables Template
# ─────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file:  cp env.example .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env — it is gitignored
# ─────────────────────────────────────────────────

# ─── Supabase ───────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Service Role Key — has full DB access, used server-side ONLY
# From: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# JWT Secret — used to verify user tokens
# From: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ─── Google AI (Gemini) ──────────────────────────────────
# From: https://aistudio.google.com/apikey
# Create a NEW key in a fresh Google Cloud project
GEMINI_API_KEY=your-gemini-api-key-here

# Phase 2G requested default; Gemini 1.5 is retired. Set an available model for live use.
COPILOT_GEMINI_MODEL=gemini-1.5-flash

# ─── Google Places API ──────────────────────────────────
# From: Google Cloud Console → APIs & Services → Credentials
# Enable: Places API (New)
PLACES_API_KEY=your-google-places-api-key-here
