# Android local.properties — Template
# ─────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file:  copy local.properties.example local.properties
#   2. Fill in your real values in local.properties
#   3. NEVER commit local.properties — it is gitignored
# ─────────────────────────────────────────────────────────

# Android SDK path (set automatically by Android Studio)
sdk.dir=C\:\\Users\\YourUsername\\AppData\\Local\\Android\\Sdk

# ─── Supabase ───────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── Backend URL ─────────────────────────────────────────
# For emulator:          http://10.0.2.2:8000
# For physical device:   http://127.0.0.1:8000  (with: adb reverse tcp:8000 tcp:8000)
# For production:        https://your-app.up.railway.app
BACKEND_URL=http://127.0.0.1:8000

# ─── Google AI (Gemini) ──────────────────────────────────
# Required for on-device AI Insights (GeminiAdvisor.kt)
# From: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Google Places API ──────────────────────────────────
# Required for merchant categorization (backend uses this)
# From: Google Cloud Console → APIs & Services → Credentials
PLACES_API_KEY=your-google-places-api-key-here
